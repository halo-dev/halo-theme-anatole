{
  "name": "@halo-dev/halo-theme-anatole",
  "version": "2.0.0",
  "description": "Anatole theme of Halo",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm run build-only && pnpm package",
    "build-only": "tsc && vite build",
    "lint": "eslint ./src --ext .js,.cjs,.mjs,.ts,.cts,.mts --ignore-path .gitignore",
    "package": "theme-package",
    "prettier": "prettier --write './src/**/*.{js,ts,css,scss,json,yml,yaml,html}' './*.{cjs,js,json,yml,yaml}'"
  },
  "homepage": "https://github.com/halo-dev/halo-theme-anatole#readme",
  "bugs": {
    "url": "https://github.com/halo-dev/halo-theme-anatole/issues"
  },
  "author": {
    "name": "Halo OSS Organization",
    "url": "https://github.com/halo-dev",
    "email": "hi@halo.run"
  },
  "maintainers": [
    {
      "name": "Ryan Wang",
      "url": "https://github.com/ruibaby",
      "email": "i@ryanc.cc"
    }
  ],
  "license": "GPL-3.0",
  "repository": {
    "url": "https://github.com/halo-dev/halo-theme-anatole",
    "type": "git"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "^1.1.1",
    "@halo-dev/vite-plugin-halo-theme": "^1.0.3",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/typography": "^0.5.20",
    "@types/alpinejs": "^3.13.11",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-plugin-icons": "^2.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "alpinejs": "^3.15.12"
  }
